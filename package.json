{
  "name": "cc-exporter",
  "version": "0.1.0",
  "description": "Export Claude Code chats in full detail to Markdown, HTML or JSON: Claude Code plugin, CLI and MCP server.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "cc-exporter": "bin/cc-exporter.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
